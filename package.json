{
  "name": "mobx-formly",
  "version": "0.0.0",
  "description": "Framework-agnostic observable forms for MobX with granular field state and Zod or Valibot validation",
  "homepage": "https://js2me.github.io/mobx-formly/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/js2me/mobx-formly.git"
  },
  "bugs": {
    "url": "https://github.com/js2me/mobx-formly/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit -p tsconfig.types.json",
    "docs:dev": "docusite dev",
    "docs:build": "docusite build",
    "docs:preview": "docusite preview"
  },
  "keywords": [
    "mobx",
    "forms",
    "form-validation",
    "typescript",
    "zod",
    "valibot",
    "react-hook-form"
  ],
  "author": "js2me",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "mobx": "^6.12.4 || ^7.0.0",
    "valibot": "^1.0.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "valibot": {
      "optional": true
    }
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "mobx": "^6.16.1",
    "yummies": "^7.20.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "docusite": "^0.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "valibot": "^1.4.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
